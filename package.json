{
  "name": "claude-motion",
  "version": "1.0.0",
  "description": "Persian motion graphics projects built with Remotion.",
  "scripts": {
    "dev": "remotion studio",
    "typecheck": "tsc --noEmit",
    "render:reel": "remotion render Reel out/reel.mp4",
    "render:tutorial": "remotion render Tutorial out/tutorial.mp4",
    "still:reel": "remotion still Reel out/reel.png --frame=60",
    "still:tutorial": "remotion still Tutorial out/tutorial.png --frame=60"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mrpirsalami-hub/claude-motion.git"
  },
  "keywords": [],
  "author": "",
