  "bugs": {
    "url": "https://github.com/mrpirsalami-hub/claude-motion/issues"
  },
  "homepage": "https://github.com/mrpirsalami-hub/claude-motion#readme",
  "dependencies": {
    "@remotion/cli": "^4.0.541",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "remotion": "^4.0.541"
  },
  "devDependencies": {
    "@types/react": "^18.3.31",
    "typescript": "^7.0.2"
  },
  "private": true
